  "image": 1,
  "subtitle": "休みの日に、\n何もする気が起きなかった。"
 },
 {
  "cut": 2,
  "start": 3.605,
  "end": 5.675,
  "image": 1,
  "subtitle": "ある看護師の話。"
 },
 {
  "cut": 3,
  "start": 5.675,
  "end": 9.152,
  "image": 1,
  "subtitle": "楽しみだった予定を、\n入れなくなっていた。"
 },
 {
  "cut": 4,
  "start": 9.152,
  "end": 12.757,
  "image": 2,
  "subtitle": "好きだった趣味の道具に、\n触れなくなっていた。"
 },
 {
  "cut": 5,
  "start": 12.757,
  "end": 16.512,
  "image": 3,
  "subtitle": "気づけば、ただ横になって\n一日が終わっていた。"
 },
 {
  "cut": 6,
  "start": 16.512,
  "end": 20.16,
  "image": 3,
  "subtitle": "最初は、疲れているだけ\nだと思った。"
 },
 {
  "cut": 7,
  "start": 20.16,
  "end": 26.069,
  "image": 4,
  "subtitle": "心の充電が、\n仕事だけで使い切られていた。"
 },
 {
  "cut": 8,
  "start": 26.069,
  "end": 33.829,
  "image": 4,
  "subtitle": "休んでも回復しないのは、\n働き方が限界に近いサイン\nかもしれない。"
 }
